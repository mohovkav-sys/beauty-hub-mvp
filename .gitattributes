# =========================================================================
# НАСТРОЙКА ПЕРЕНОСОВ СТРОК ДЛЯ РЕПОЗИТОРИЯ «BEAUTY HUB»
# =========================================================================

# Автоматически определять текстовые файлы и нормализовать переводы строк в репозитории к LF,
# при этом в рабочей копии на Windows Git будет корректно с ними работать без лишних сбоев
* text=auto eol=lf

# Явно фиксируем LF для исходного кода, стилей и конфигураций
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf